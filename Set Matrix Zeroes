class Solution {
    public void setZeroes(int[][] nums) {
        boolean[] rows = new boolean[nums.length];
        boolean[] cols = new boolean[nums[0].length];
        for(int i = 0 ; i < nums.length;i++){
            for(int j = 0 ; j < nums[0].length;j++){
                if(nums[i][j] == 0){
                    rows[i] = true;
                    cols[j] = true;
                }
            }

            
        }
        for(int i = 0 ; i < nums.length;i++){
            for(int j = 0 ; j < nums[0].length;j++){
                if(rows[i] || cols[j]){
                    nums[i][j] = 0;
                }
            }
        }
    }
}
